{
  "name": "astra-gate-plugins",
  "private": true,
  "type": "module",
  "description": "Provider and middleware plugins for Astra (magpie-compatible), with a small shared kit.",
  "workspaces": [
    "kit",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"kit/test/*.test.mjs\" \"packages/*/test/*.test.mjs\"",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "license": "MIT"
}
