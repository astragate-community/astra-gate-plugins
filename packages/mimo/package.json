{
  "name": "@astragate-community/mimo-auth",
  "version": "0.1.10",
  "description": "OpenCode provider plugin for Xiaomi MiMo: the MiMo app's Xiaomi-account sign-in, MiMo Pro and MiMo Flash",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "xiaomi",
    "mimo",
    "astra",
    "magpie"
  ],
  "license": "MIT",
  "upstream": {
    "package": "@magpie-community/opencode-mimo-auth",
    "version": "0.1.9"
  },
  "upstreamDiff": [
    "._internal"
  ],
  "magpie": {
    "icon": "https://unpkg.com/@lobehub/icons-static-svg@1.95.1/icons/xiaomimimo.svg"
  },
  "astra": {
    "name": "Xiaomi MiMo",
    "icon": "https://unpkg.com/@lobehub/icons-static-svg@1.95.1/icons/xiaomimimo.svg",
    "providers": [
      "mimo-app"
    ],
    "replaces": "mimo-app",
    "summary": {
      "en": "Xiaomi MiMo models with your Xiaomi account.",
      "zh": "用小米账号使用小米 MiMo 模型。"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astragate-community/astra-gate-plugins.git",
    "directory": "packages/mimo"
  }
}
