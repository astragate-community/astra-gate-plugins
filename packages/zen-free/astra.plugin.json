{
  "manifestVersion": 2,
  "id": "astragate-community.zen-free",
  "version": "2.1.0",
  "name": { "zh": "OpenCode Zen 免费模型", "en": "OpenCode Zen Free" },
  "description": {
    "zh": "使用 public 凭证接入 OpenCode Zen 免费模型，自动发现模型并支持原生流式协议。",
    "en": "OpenCode Zen's free models with the public credential, automatic discovery and native streaming protocols."
  },
  "icon": "assets/icon.svg",
  "publisher": { "name": "Astra Gate Community", "url": "https://github.com/astragate-community" },
  "license": "MIT",
  "homepage": "https://github.com/astragate-community/astra-gate-plugins/tree/main/packages/zen-free",
  "engines": { "astra": ">=0.15.0", "api": "^2.0" },
  "main": "src/main.js",
  "permissions": [
    "providers",
    "storage",
    "ui",
    "net:https://opencode.ai",
    "net:https://models.opencode.ai",
    "net:https://raw.githubusercontent.com"
  ],
  "contributes": {
    "providers": [
      {
        "id": "opencode-zen-free",
        "name": { "zh": "OpenCode Zen 免费", "en": "OpenCode Zen Free" },
        "icon": "assets/icon.svg",
        "protocols": ["chat", "responses", "anthropic"],
        "reply": { "framing": "sse", "output": "anthropic" },
        "models": [
          { "id": "big-pickle", "name": "Big Pickle", "protocol": "chat", "context": 200000, "output": 32000, "reasoning": true },
          { "id": "space-bunny-free", "name": "Space Bunny Free", "protocol": "chat", "context": 1048576, "output": 524288, "reasoning": true },
          { "id": "muse-spark-1.3-contributor-free", "name": "Muse Spark 1.3 Free", "protocol": "responses", "context": 1048576, "output": 131072, "reasoning": true, "vision": true }
        ],
        "signIn": { "flow": "signIn" }
      }
    ],
    "ui.flows": [
      { "id": "signIn", "view": "signIn", "title": { "zh": "启用 Zen 免费访问", "en": "Enable Zen free access" } }
    ]
  },
  "replaces": [{ "v1": "@astragate-community/zen-free-auth" }]
}
