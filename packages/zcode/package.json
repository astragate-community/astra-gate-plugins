  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "astra",
    "zcode",
    "z.ai",
    "bigmodel",
    "glm",
    "coding-plan"
  ],
  "license": "MIT",
  "upstream": {
    "package": "@magpie-community/opencode-zcode-auth",
    "version": "0.1.17"
  },
