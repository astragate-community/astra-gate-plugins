  "type": "module",
  "files": [
    "index.mjs",
    "README.md"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "new-api",
    "sensitive-words",
    "guardrails",
    "llm-gateway",
    "astra"
  ],
  "license": "MIT",
  "magpie": {
    "middleware": "./index.mjs",
    "options": {
      "words": [
        "project-codename"
      ],
      "patterns": [],
      "action": "reject",
      "check": "last"
    }
  },
  "upstream": {
    "package": "@magpie-community/middleware-word-guard",
    "version": "0.1.1"
  },
  "upstreamDiff": []
}
