{
  "manifestVersion": 2,
  "id": "astragate-community.minimax",
  "version": "2.1.0",
  "name": { "zh": "MiniMax Code", "en": "MiniMax Code" },
  "description": {
    "zh": "用 MiniMax Code 账号的积分与 M Plan（国内站与国际站），使用 MiniMax Code 自己的设备登录。",
    "en": "MiniMax Code account credits and M Plan (China and international sites), with MiniMax Code's own device sign-in."
  },
  "icon": "assets/icon.svg",
  "publisher": { "name": "Astra Gate Community", "url": "https://github.com/astragate-community" },
  "license": "MIT",
  "homepage": "https://github.com/astragate-community/astra-gate-plugins/tree/main/packages/minimax",
  "engines": { "astra": ">=0.15.0", "api": "^2.0" },
  "main": "src/main.js",
  "permissions": [
    "providers",
    "ui",
    "net:https://account.minimax.cn",
    "net:https://agent.minimax.cn",
    "net:https://agent.minimaxi.com",
    "net:https://www.minimaxi.com",
    "net:https://account.minimax.io",
    "net:https://agent.minimax.io",
    "net:https://platform.minimax.io"
  ],
  "contributes": {
    "providers": [
      {
        "id": "minimax-code",
        "name": { "zh": "MiniMax Code（国内）", "en": "MiniMax Code" },
        "icon": "assets/icon.svg",
        "protocols": ["anthropic"],
        "reply": { "framing": "sse", "output": "anthropic" },
        "models": [
          { "id": "MiniMax-M3.1-Flash-Preview", "name": "M3.1-Flash-Preview", "protocol": "anthropic", "context": 512000, "output": 128000, "reasoning": true, "vision": true },
          { "id": "MiniMax-M3", "name": "MiniMax-M3", "protocol": "anthropic", "context": 512000, "output": 128000, "reasoning": true, "vision": true },
          { "id": "MiniMax-M2.7", "name": "MiniMax-M2.7", "protocol": "anthropic", "context": 200000, "output": 128000, "reasoning": true },
          { "id": "MiniMax-M2.7-highspeed", "name": "MiniMax-M2.7-highspeed", "protocol": "anthropic", "context": 200000, "output": 128000, "reasoning": true }
        ],
        "signIn": { "flow": "signIn" }
      },
      {
        "id": "minimax-code-global",
        "name": { "zh": "MiniMax Code（国际）", "en": "MiniMax Code (Global)" },
        "icon": "assets/icon.svg",
        "protocols": ["anthropic"],
        "reply": { "framing": "sse", "output": "anthropic" },
        "models": [
          { "id": "MiniMax-M3.1-Flash-Preview", "name": "M3.1-Flash-Preview", "protocol": "anthropic", "context": 512000, "output": 128000, "reasoning": true, "vision": true },
          { "id": "MiniMax-M3", "name": "MiniMax-M3", "protocol": "anthropic", "context": 512000, "output": 128000, "reasoning": true, "vision": true },
          { "id": "MiniMax-M2.7", "name": "MiniMax-M2.7", "protocol": "anthropic", "context": 200000, "output": 128000, "reasoning": true },
          { "id": "MiniMax-M2.7-highspeed", "name": "MiniMax-M2.7-highspeed", "protocol": "anthropic", "context": 200000, "output": 128000, "reasoning": true }
        ],
        "signIn": { "flow": "signIn" }
      }
    ],
    "ui.flows": [
      { "id": "signIn", "view": "signIn", "title": { "zh": "登录 MiniMax Code", "en": "Sign in to MiniMax Code" } }
    ]
  },
  "replaces": [{ "v1": "@astragate-community/minimax-auth" }]
}
